      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "query": "import \"math\"\n\ndepth = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.host == \"${host}\")\n  |> filter(fn: (r) => r._measurement == \"sov_rollup_zk_stf_info_channel\")\n  |> filter(fn: (r) => r._field == \"channel_depth\")\n  |> last()\n\ncapacity = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.host == \"${host}\")\n  |> filter(fn: (r) => r._measurement == \"sov_rollup_zk_stf_info_channel\")\n  |> filter(fn: (r) => r._field == \"channel_capacity\")\n  |> last()\n\njoin(tables: {depth: depth, capacity: capacity}, on: [\"_time\", \"host\"])\n  |> map(fn: (r) => ({r with _value: (float(v: r._value_depth) / float(v: r._value_capacity)) * 100.0}))",
          "refId": "A"
        }
      ],
      "title": "Channel Utilization",
      "type": "stat"
    },
