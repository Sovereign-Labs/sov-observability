          "query": "import \"math\"\n\nfrom(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._field == \"hyperlane_messages_processed_count\")\n  |> filter(fn: (r) => r.agent == \"relayer\")\n  |> derivative(unit: 5m, nonNegative: true)\n  |> group(columns: [\"origin\", \"remote\"])\n  |> aggregateWindow(every: ${agg_interval}, fn: sum, createEmpty: false)\n  |> map(fn: (r) => ({r with _value: math.round(x: r._value)}))",
          "refId": "A"
        }
      ],
      "title": "Messages Processed",
      "type": "timeseries"
    },
